pipeline {
    agent {
        docker {
            image 'my-jenkins-agent:v1'
            args '-u root -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache-nginx:/root/.cache/trivy'
        }
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'TARGET_HASH', defaultValue: '', description: 'Commit to build (set by the integration job); empty = branch head')
    }

    environment {
        DOCKERHUB = credentials('docker-hub-creds')
        IMAGE     = "${DOCKERHUB_USR}/docker-monitor-nginx"
        TAG       = "${params.TARGET_HASH ? params.TARGET_HASH.take(7) : env.GIT_COMMIT.take(7)}"
    }

    stages {
        stage('Checkout Target Commit') {
            when { expression { params.TARGET_HASH } }
            steps {
                sh 'git config --global --add safe.directory "$WORKSPACE"'
                sh 'git checkout $TARGET_HASH'
            }
        }

        stage('Docker Hub Login') {
            steps {
                // avoids the Docker Hub pull limit
                sh 'echo "$DOCKERHUB_PSW" | docker login -u "$DOCKERHUB_USR" --password-stdin'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build --pull -t $IMAGE:$TAG docker-monitor/nginx'
            }
        }

        stage('Config Test') {
            steps {
                // nginx -t needs the upstream name to resolve
                sh 'docker run --rm --add-host docker-monitor:127.0.0.1 $IMAGE:$TAG nginx -t'
            }
        }

        stage('Image Scan (report only)') {
            steps {
                // report only
                sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL --ignore-unfixed $IMAGE:$TAG'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh 'docker push $IMAGE:$TAG'
            }
        }
    }

    post {
        always {
            sh 'docker rmi $IMAGE:$TAG || true'
            sh 'docker logout || true'
            cleanWs()
        }
    }
}
