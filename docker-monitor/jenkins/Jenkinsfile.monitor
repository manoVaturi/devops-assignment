pipeline {
    agent {
        docker {
            image 'my-jenkins-agent:v1'
            args '-u root -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache-monitor:/root/.cache/trivy'
        }
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'TARGET_HASH', defaultValue: '', description: 'Commit to build (set by the integration job); empty = branch head')
    }

    environment {
        DOCKERHUB = credentials('docker-hub-creds')
        IMAGE     = "${DOCKERHUB_USR}/docker-monitor-app"
        TAG       = "${params.TARGET_HASH ? params.TARGET_HASH.take(7) : env.GIT_COMMIT.take(7)}"
    }

    stages {
        stage('Checkout Target Commit') {
            when { expression { params.TARGET_HASH } }
            steps {
                sh 'git config --global --add safe.directory "$WORKSPACE"'
                sh 'git checkout $TARGET_HASH'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('docker-monitor/monitor') {
                    sh 'pip install -r requirements.txt -r requirements-test.txt'
                }
            }
        }

        stage('Checks') {
            parallel {
                stage('Lint') {
                    steps {
                        dir('docker-monitor/monitor') {
                            sh 'flake8 app tests'
                        }
                    }
                }
                stage('Security Scan (SAST)') {
                    steps {
                        dir('docker-monitor/monitor') {
                            sh 'bandit -r app/'
                        }
                    }
                }
                stage('Unit Tests') {
                    steps {
                        dir('docker-monitor/monitor') {
                            sh 'python -m pytest tests -v --junitxml=report.xml'
                        }
                    }
                    post {
                        always {
                            junit 'docker-monitor/monitor/report.xml'
                        }
                    }
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                // avoids the Docker Hub pull limit
                sh 'echo "$DOCKERHUB_PSW" | docker login -u "$DOCKERHUB_USR" --password-stdin'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build --pull -t $IMAGE:$TAG docker-monitor/monitor'
            }
        }

        stage('Image Scan (report only)') {
            steps {
                // report only
                sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL --ignore-unfixed $IMAGE:$TAG'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh 'docker push $IMAGE:$TAG'
            }
        }
    }

    post {
        always {
            sh 'docker rmi $IMAGE:$TAG || true'
            sh 'docker logout || true'
            cleanWs()
        }
    }
}
